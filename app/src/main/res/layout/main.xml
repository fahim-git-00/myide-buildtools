<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E">

    <!-- ==================== MAIN CONTENT ==================== -->
    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Tab strip -->
        <HorizontalScrollView
            android:id="@+id/tabStrip"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#252526"
            android:scrollbars="none" />

        <!-- Editor row: line numbers + editor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lineNumbers"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="#1E1E1E"
                android:gravity="top|end"
                android:minWidth="40dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="8dp"
                android:text="1"
                android:textColor="#858585"
                android:textSize="13sp"
                android:typeface="monospace" />

            <EditText
                android:id="@+id/editor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:padding="8dp"
                android:scrollbars="vertical|horizontal"
                android:textColor="#D4D4D4"
                android:textSize="13sp"
                android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dim layer — sits ABOVE main content but BELOW sidebar -->
    <View
        android:id="@+id/dimLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <!-- Sidebar — last child = topmost z-order -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:background="#252526"
        android:elevation="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtProjectPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:ellipsize="middle"
            android:padding="12dp"
            android:singleLine="true"
            android:text="No project"
            android:textColor="#DCDCAA"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpenFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\uD83D\uDCC1 Open folder" />

        <ListView
            android:id="@+id/fileList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#333333"
            android:dividerHeight="1dp" />
    </LinearLayout>

</RelativeLayout>
